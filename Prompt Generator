<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مولد برومبات البحوث الأكاديمية</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
        }
        .gradient-bg {
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        }
    </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 pb-12">

    <!-- Header -->
    <header class="gradient-bg text-white pt-8 pb-16 px-4 relative shadow-md">
        <div class="max-w-xl mx-auto flex items-center justify-between">
            <div class="text-right">
                <h1 class="text-2xl md:text-3xl font-black mb-1 tracking-wide">مولد برومبات البحوث</h1>
                <h2 class="text-xl md:text-2xl font-black mb-3 tracking-wide">الأكاديمية</h2>
                <p class="text-blue-100 text-xs md:text-sm max-w-xs leading-relaxed">اصنع أوامر احترافية ودقيقة للذكاء الاصطناعي لكتابة وتطوير أبحاثك ودروسك</p>
            </div>
            <div class="bg-yellow-400 p-3 rounded-2xl shadow-md text-blue-900 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
            </div>
        </div>
        <!-- Status Pill -->
        <div class="absolute -bottom-4 left-1/2 transform -translate-x-1/2 bg-blue-600/90 backdrop-blur border border-blue-400/30 text-white text-xs px-5 py-1.5 rounded-full shadow-lg flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-green-400 rounded-full inline-block animate-pulse"></span>
            جاهز للاستخدام الفوري
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-xl mx-auto px-4 mt-8">
        <div class="bg-white rounded-3xl shadow-xl p-6 md:p-8 border border-slate-100">
            
            <!-- Section Title & Reset -->
            <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100">
                <div class="flex items-center gap-2 text-slate-800 font-bold text-base md:text-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                    </svg>
                    إعدادات البحث والخصائص
                </div>
                <button type="button" id="resetBtn" class="text-xs text-slate-400 hover:text-blue-600 flex items-center gap-1 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    إعادة ضبط
                </button>
            </div>

            <form id="promptForm" class="space-y-6">
                
                <!-- 1. Topic -->
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-2 flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                        عنوان أو موضوع البحث الرئيسي *
                    </label>
                    <input type="text" id="topic" required placeholder="مثال: تأثير الذكاء الاصطناعي على مهارات التفكير الناقد" 
                        class="w-full px-4 py-3.5 rounded-2xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                </div>

                <!-- 2. Academic Field -->
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-2 flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                        التخصص الأكاديمي
                    </label>
                    <select id="field" class="w-full px-4 py-3.5 rounded-2xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                        <option value="العلوم الإنسانية والاجتماعية">العلوم الإنسانية والاجتماعية</option>
                        <option value="التربية وطرق التدريس">التربية وطرق التدريس</option>
                        <option value="علوم الحاسب وتقنية المعلومات">علوم الحاسب وتقنية المعلومات</option>
                        <option value="الإدارة والاقتصاد">الإدارة والاقتصاد</option>
                        <option value="اللغة العربية وآدابها">اللغة العربية وآدابها</option>
                    </select>
                </div>

                <!-- 3. Work Type -->
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-2 flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        نوع العمل المطلوب
                    </label>
                    <select id="type" class="w-full px-4 py-3.5 rounded-2xl border border-slate-200 bg-slate-50/50 focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-sm">
                        <option value="ورقة بحثية متكاملة (Research Paper)">ورقة بحثية متكاملة (Research Paper)</option>
                        <option value="بحث تخرج أو دراسة ميدانية">بحث تخرج أو دراسة ميدانية</option>
                        <option value="مقال مراجعة علمية (Literature Review)">مقال مراجعة علمية (Literature Review)</option>
                        <option value="خطة بحث (Proposal) تفصيلية">خطة بحث (Proposal) تفصيلية</option>
                    </select>
                </div>

                <button type="submit" class="w-full gradient-bg text-white font-bold py-4 rounded-2xl shadow-lg hover:opacity-95 transition duration-200 flex items-center justify-center gap-2 text-base mt-8">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    توليد البرومبت الاحترافي
                </button>
            </form>

            <!-- Output Section -->
            <div id="outputSection" class="mt-8 pt-6 border-t border-slate-100 hidden">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-bold text-slate-800 flex items-center gap-1.5">
                        <span class="w-2.5 h-2.5 bg-green-500 rounded-full inline-block"></span>
                        البرومبت الاحترافي جاهز:
                    </h3>
                    <button id="copyBtn" class="bg-slate-900 hover:bg-slate-800 text-white px-3.5 py-1.5 rounded-xl text-xs font-semibold transition flex items-center gap-1 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                        </svg>
                        نسخ
                    </button>
                </div>
                <div class="bg-slate-900 text-slate-100 p-4 rounded-2xl font-mono text-xs leading-relaxed whitespace-pre-wrap select-all overflow-x-auto shadow-inner" id="resultBox"></div>
            </div>

        </div>
    </main>

    <!-- Script -->
    <script>
        const form = document.getElementById('promptForm');
        const outputSection = document.getElementById('outputSection');
        const resultBox = document.getElementById('resultBox');
        const copyBtn = document.getElementById('copyBtn');
        const resetBtn = document.getElementById('resetBtn');

        form.addEventListener('submit', function(e) {
            e.preventDefault();

            const topic = document.getElementById('topic').value.trim();
            const field = document.getElementById('field').value;
            const type = document.getElementById('type').value;

            let promptText = `أنت باحث أكاديمي وخبير محترف في كتابة الأبحاث والدراسات العلمية. مطلوب منك إعداد وتوليد "${type}" كاملة ومنظمة بعناية فائقة حول الموضوع التالي:

عنوان البحث: "${topic}"
التخصص الأكاديمي: ${field}

يرجى الالتزام بالمعايير التالية عند كتابة البحث:
1. الهيكلة الأكاديمية الاحترافية (المقدمة، الإطار النظري، التحليل أو الدراسة، النتائج، والخاتمة).
2. لغة عربية فصحى رصينة، خالية من الأخطاء الإملائية والنحوية، وذات أسلوب علمي محكم.
3. تفصيل الأفكار بوضوح ودعمها بالتحليلات المنطقية مع ذكر مصادر ومراجع مقترحة مطابقة لنمط (APA).
4. تقديم المحتوى بشكل منسق مع استخدام العناوين الرئيسية والفرعية لتسهيل القراءة والمراجعة.`;

            resultBox.textContent = promptText;
            outputSection.classList.remove('hidden');
            outputSection.scrollIntoView({ behavior: 'smooth' });
        });

        resetBtn.addEventListener('click', function() {
            form.reset();
            outputSection.classList.add('hidden');
        });

        copyBtn.addEventListener('click', function() {
            const textToCopy = resultBox.textContent;
            navigator.clipboard.writeText(textToCopy).then(() => {
                const originalText = copyBtn.innerHTML;
                copyBtn.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    تم النسخ!
                `;
                setTimeout(() => {
                    copyBtn.innerHTML = originalText;
                }, 2000);
            });
        });
    </script>
</body>
</html>
